
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DHT.h>

const char* ssid = "nama wifi"; // Ganti dengan SSID
const char* password = "password wifi"; // Ganti dengan password WiFi

#define BOT_TOKEN "isi dengan bot token" // Ganti dengan token bot Anda
#define CHAT_ID "5946869783" // Ganti dengan chat ID Anda

#define DHTPIN 4
#define DHTTYPE DHT11

#define MQ135_PIN 34
#define LED_PIN 2
#define BUZZER_PIN 25

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

DHT dht(DHTPIN, DHTTYPE);
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

void setup() {
  Serial.begin(115200);

  delay(1000); // Memberikan waktu untuk Serial Monitor terbuka

  WiFi.begin("Kelas Robot", "kumaha aa we");

  Serial.print("Menghubungkan ke WiFi");
  
  While (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi terhubung!");
  Serial.print("IP ESP32: ");
  Serial.println(WiFi.localIP());

  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  // Pengaturan buzzer
  ledcSetup(0, 2000, 8);
  ledcAttachPin(BUZZER_PIN, 0);

  dht.begin();

  Wire.begin(21, 22);

  // Inisialisasi OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED tidak ditemukan!");
    while (true);
  }


  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);

  display.println("Monitoring Udara");
  display.println("Memulai...");
  display.display();

  delay(2000);
}

void loop() {

  // Membaca sensor
  float suhu = dht.readTemperature();
  float kelembapan = dht.readHumidity();
  int udara = analogRead(MQ135_PIN);

  // Mengecek sensor DHT11
  if (isnan(suhu) || isnan(kelembapan)) {
    Serial.println("DHT11 gagal membaca!");

    digitalWrite(LED_PIN, LOW);
    ledcWriteTone(0, 0);

    return;
  }

  // Menampilkan data ke Serial Monitor
  Serial.print("Suhu: ");
  Serial.print(suhu);
  Serial.print(" C | Kelembapan: ");
  Serial.print(kelembapan);
  Serial.print(" % | MQ-135: ");
  Serial.println(udara);

  // =========================
  // LOGIKA LED DAN BUZZER
  // =========================

  if (udara > 2000) {
    // MQ-135 mendeteksi gas

    // Kondisi tidak sesuai batas
    digitalWrite(LED_PIN, HIGH);
    ledcWriteTone(0, 2000); // Buzzer berbunyi dengan frekuensi 1000 Hz

  } else {

    // udara normal
    digitalWrite(LED_PIN, LOW);
    ledcWriteTone(0, 0);
  }

  // =========================
  // TAMPILAN OLED
  // =========================

  display.clearDisplay();

  display.setCursor(0, 0);
  display.println("MONITORING UDARA");

  display.setCursor(0, 18);
  display.print("MQ-135 : ");
  display.println(udara);

  display.setCursor(0, 32);
  display.print("Suhu   : ");
  display.print(suhu);
  display.println(" C");

  display.setCursor(0, 46);
  display.print("Lembap : ");
  display.print(kelembapan);
  display.println(" %");

  display.display();

  delay(2000);
}